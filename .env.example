# ==============================================================================
# BAKU ESTATE AI - Configuration Environment File
# ==============================================================================
# Copy this file to .env and fill in your rotated secrets. NEVER commit .env.

# ------------------------------------------------------------------------------
# Supabase Cloud Core (Single Source of Truth)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=
# Server-side service_role JWT (ONLY for Windows local worker & Edge Functions; NEVER expose to browser!)
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible alias (if SUPABASE_SERVICE_ROLE_KEY is unset, SUPABASE_KEY is read)
SUPABASE_KEY=
# Public anon key (used by Web CRM with Supabase Auth + RLS)
SUPABASE_ANON_KEY=
# Public storage bucket for versioned videos (videos/{bina_id}/v{n}.mp4)
SUPABASE_BUCKET=baku-estate-media
SUPABASE_ENABLED=true
# Master switch for Cloud Postgres backend (set false only for legacy SQLite fallback)
USE_CLOUD_BACKEND=true

# ------------------------------------------------------------------------------
# Telegram CRM / Dispatcher & 24/7 Webhook Credentials
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram and get your Bot Token
TELEGRAM_BOT_TOKEN=
# Authorized operator Chat ID (e.g. 123456789 or -100123456789)
TELEGRAM_CHAT_ID=
# Secret token sent in X-Telegram-Bot-Api-Secret-Token header by Telegram Webhook
TELEGRAM_WEBHOOK_SECRET=
# Shared secret for pg_cron -> Edge Function invocations (followup-dispatcher, storage-pruner, cockpit-generator)
CRON_SECRET=
# If set to true, simulates sending without calling Telegram API. Set to false to dispatch live videos!
TELEGRAM_MOCK_DISPATCH=true
# Agency Public WhatsApp Phone for inbound lead attribution (e.g. 994501234567)
AGENCY_WHATSAPP_PHONE=994501234567

# ------------------------------------------------------------------------------
# v2 Cloud Worker (Railway), Private Cloudflare R2, Proxy & Official Social API
# ------------------------------------------------------------------------------
# Worker execution mode ('local' or 'cloud')
WORKER_MODE=local
# Commercial ISP/Residential proxy URL (Webshare HTTP, 15GB/$20 ceiling)
BINA_PROXY_URL=
# Cloudflare R2 Private Bucket & Signed Custom Domain CDN
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baku-estate-media
R2_MEDIA_BASE_URL=
R2_SIGNING_SECRET=
# Social publishing mode: 'TELEGRAM_FALLBACK' (<=45d transition) or 'OFFICIAL'
SOCIAL_API_MODE=TELEGRAM_FALLBACK
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Rejim 3 Auto-Render Guardrails, Currency Normalization & Worker Settings
# ------------------------------------------------------------------------------
# Currency conversion rates to AZN for accurate price-drop comparison
USD_TO_AZN_RATE=1.70
EUR_TO_AZN_RATE=1.85
# Minimum AZN price drop percentage to trigger an automatic vN re-render
PRICE_DROP_TRIGGER_PCT=5.0
# Maximum automatic renders per Asia/Baku calendar day
DAILY_AUTO_RENDER_LIMIT=5
# Per-listing cooldown (hours) between automatic renders
AUTO_RENDER_COOLDOWN_HOURS=24
# Stale AUTO pipeline_jobs older than this TTL (hours) expire on wake-up
AUTO_JOB_TTL_HOURS=24
# Days before SUPERSEDED/ARCHIVED/OWNER_SOLD MP4 files are pruned from Supabase Storage
STORAGE_PRUNE_DAYS=14
# Unique identifier for this Windows local worker instance (defaults to machine hostname)
WORKER_ID=win-local-worker-1
# Asia/Baku (UTC+4) quiet hours for follow-up Telegram notifications
BAKU_QUIET_START=21:30
BAKU_QUIET_END=09:00

# ------------------------------------------------------------------------------
# Bina.az Scraping Filters
# ------------------------------------------------------------------------------
# City ID: 1 = Baku, 2 = Ganja, 3 = Sumqayit, etc.
CITY_ID=1
# Price filters in AZN (0 = no limit)
MIN_PRICE=0
MAX_PRICE=0
# Filter direct owner only
BINA_OWNER_ONLY=true
# Only filter listings with Kupça when explicitly set to true (default false)
SCRAPE_HAS_BILL_OF_SALE=false

# ------------------------------------------------------------------------------
# Background Daemon / Scheduler Settings
# ------------------------------------------------------------------------------
# Daily run times (comma-separated HH:MM, 24h format) e.g. 12:30,19:30
SCHEDULE_TIMES=12:30,19:30
# Periodic interval in hours (set to >0 to run periodically instead of fixed times, 0 to use SCHEDULE_TIMES)
SCHEDULE_INTERVAL_HOURS=0
# Number of pages to scan per run
SCHEDULE_PAGES=1
# Maximum videos to generate & dispatch per scheduled run
SCHEDULE_LIMIT=3
# Run immediately on daemon startup before waiting for next scheduled time
SCHEDULE_RUN_ON_STARTUP=true

# ------------------------------------------------------------------------------
# Google Account Pool Settings
# ------------------------------------------------------------------------------
GOOGLE_POOL_SIZE=6
ACCOUNT_COOLDOWN_SECONDS=600
ACCOUNT_DAILY_QUOTA=50

# ------------------------------------------------------------------------------
# Voiceover TTS Engines (ElevenLabs Studio / OpenAI / Edge-TTS)
# ------------------------------------------------------------------------------
TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ZQJv3hwvRAIC7fvWZ1Qr
ELEVENLABS_VOICE_ARIF=ZQJv3hwvRAIC7fvWZ1Qr
ELEVENLABS_VOICE_AYAN=DZaip8UahF0Qri1FxU8M
ELEVENLABS_VOICE_BANU=DZaip8UahF0Qri1FxU8M
ELEVENLABS_MODEL_ID=eleven_v4

OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_SPEED=1.05

EDGE_TTS_VOICE=az-AZ-BabekNeural
EDGE_TTS_RATE=+10%
EDGE_TTS_VOLUME=+0%
